{
  "server_ip": {
    "description": "服务器地址",
    "type": "string",
    "hint": "Minecraft 服务器的 IP 地址或域名",
    "default": "127.0.0.1"
  },
  "server_port": {
    "description": "服务器端口",
    "type": "int",
    "hint": "Java 版默认 25565，基岩版通常不支持 Ping 协议请注意",
    "default": 25565
  },
  "rcon_port": {
    "description": "RCON 端口",
    "type": "int",
    "hint": "server.properties 中的 rcon.port，默认 25575",
    "default": 25575
  },
  "rcon_password": {
    "description": "RCON 密码",
    "type": "string",
    "hint": "server.properties 中的 rcon.password",
    "default": ""
  },
  "interval": {
    "description": "监控间隔(秒)",
    "type": "int",
    "hint": "轮询服务器的时间间隔，建议 30-60 秒",
    "default": 30
  },
  "auto_start": {
    "description": "自动启动监控",
    "type": "bool",
    "hint": "插件加载时是否自动开启后台统计任务",
    "default": true
  },
  "rank_start_hour": {
    "description": "排行榜起始小时",
    "type": "int",
    "hint": "每日排行榜从几点开始统计(0-23)。填 0 代表按自然日(00:00)计算。",
    "default": 0
  },
  "daily_start_hour": {
    "description": "作息判定起始小时",
    "type": "int",
    "hint": "早起/熬夜判定界限(0-23)。填 5 代表凌晨 5 点前下线依然算作前一天深夜。",
    "default": 5
  },
  "player_blacklist": {
    "description": "玩家黑名单",
    "type": "string",
    "hint": "黑名单玩家ID，多个用逗号分隔（例如 Steve,Alex）。黑名单玩家会持续清理历史数据且不再记录时长。",
    "default": ""
  }
}
